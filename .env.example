# ============================================================
#  Settings of the shop program. Copy this file to ".env" and fill it in.
#  NEVER upload ".env" to GitHub or send it to anyone: it holds your secrets.
# ============================================================

# Password to log in (and to confirm closing a day, editing a saved day, deleting with logs)
APP_PASSWORD=change-me

# Turso: the online copy of the database (turso.tech). Leave empty to keep the data only on this computer.
TURSO_URL=
TURSO_TOKEN=
# Slow internet: how long to wait for Turso before trying again later (seconds)
TURSO_TIMEOUT_SECONDS=120

# Updates from GitHub: the program shows «تحديث متاح» and installs it ONLY when someone presses it and types
# UPDATE_PASSWORD (choose it yourself; empty = nobody can update). Leave GITHUB_REPO empty to turn updates off.
UPDATE_PASSWORD=
GITHUB_REPO=mazenalhadidy/elbshmds
GITHUB_BRANCH=main
# Needed only if the repository is PRIVATE: a fine-grained token with "Contents: Read-only" on this repository
GITHUB_TOKEN=
UPDATE_CHECK_MINUTES=10

# Only if your OLD version kept its data in another file (default: data/shop.db next to this file)
# LEGACY_DB_FILE=C:\shop-finance\data\shop.db

# Port of the program (phones open http://<this computer's address>:PORT)
PORT=3000

# Where the database and backups live (default: the "data" folder next to this file). Docker uses /data.
# DATA_DIR=data
# Requests slower than this (milliseconds) are written to the log, to spot slowness early
# SLOW_REQUEST_MS=1000
