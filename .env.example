# Copy this file to ".env" and fill the values. NEVER upload ".env" to GitHub or share it: it holds your secrets.
APP_PASSWORD=1234
# Turso online database (turso.tech). Leave both empty to use a local file instead.
TURSO_URL=libsql://your-database-name-your-user.turso.io
TURSO_TOKEN=paste-your-turso-token-here
# A readable copy of the whole database is saved in data/turso-copy.json every 15 minutes. Write LOCAL_COPY=off to disable.
